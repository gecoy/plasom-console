// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// Enums
// ===========================

enum TicketStatus {
  SUBMITTED   // ส่งเรื่องแล้ว
  RECEIVED    // รับเรื่องแล้ว
  IN_PROGRESS // ช่างกำลังเข้าซ่อม
  COMPLETED   // เสร็จสิ้น
  CANCELLED   // ยกเลิก
}

enum ServiceType {
  CLEANING     // ล้างแอร์
  REPAIR       // ซ่อมแอร์
  INSTALLATION // ติดตั้ง/ย้ายแอร์
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
}

enum MessageSender {
  CUSTOMER
  BOT
  STAFF
}

// ===========================
// Models
// ===========================

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())

  tickets  Ticket[]
  messages Message[]
  projects Project[]
  reviews  Review[]
}

model Project {
  id                 String   @id @default(cuid())
  ownerId            String
  name               String
  category           String
  branchName         String
  chatbotConnected   Boolean  @default(false)
  botnoiBotId        String?
  voicebotConnected  Boolean  @default(false)
  voiceAgentId       String?
  greetingMessage    String   @default("")
  requiredFields     String[] @default([])
  features           Json     @default("{}")
  webhookSecretHash  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  technicians  Technician[]
  reviews      Review[]
  botnoiChatEvents BotnoiChatEvent[]

  @@index([ownerId])
  @@index([botnoiBotId])
}

model Technician {
  id          String           @id @default(cuid())
  name        String
  phone       String
  area        String           // พื้นที่รับผิดชอบ
  specialty   String?
  status      TechnicianStatus @default(AVAILABLE)
  projectId   String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tickets Ticket[]

  @@index([projectId])
}

model Ticket {
  id            String      @id @default(cuid())
  trackingCode  String      @unique  // รหัสติดตาม รูปแบบ CC-YYYYMMDD-XXXX
  service       ServiceType
  brand         String      // ยี่ห้อแอร์
  symptom       String      // อาการเสีย
  address       String      // ที่อยู่
  lat           Float?      // พิกัด latitude (optional)
  lng           Float?      // พิกัด longitude (optional)
  preferredDate DateTime    // วัน-เวลาที่สะดวก
  note          String?     // หมายเหตุ
  extraFields   Json        @default("{}")
  status        TicketStatus @default(SUBMITTED)

  // ห้องแชท Botnoi ที่ผูกกับใบงานนี้ (ใช้รับประวัติแชทและส่งข้อความขอรีวิว)
  botnoiSourceId    String?
  botnoiChannel     String?   // line / facebook / app
  reviewRequestedAt DateTime?

  // ข้อมูลผู้แจ้ง (ลูกค้าอาจไม่ได้ล็อกอิน)
  customerName  String
  customerPhone String

  // ความสัมพันธ์ optional
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  technicianId  String?
  technician    Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // ตารางลูก
  images        TicketImage[]
  statusLogs    StatusLog[]
  messages      Message[]
  review        Review?

  // Index สำหรับ query ที่ใช้บ่อย
  @@index([customerPhone])
  @@index([status])
  @@index([projectId, createdAt])
  @@index([projectId, botnoiSourceId])
}

model TicketImage {
  id       String @id @default(cuid())
  url      String // path ของรูป เช่น /uploads/xxx.jpg
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
}

model StatusLog {
  id        String       @id @default(cuid())
  status    TicketStatus // สถานะ ณ ตอนนั้น
  note      String?      // หมายเหตุเพิ่มเติม
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  createdAt DateTime     @default(now())
}

model Message {
  id        String   @id @default(cuid())
  text      String
  fromStaff Boolean  @default(false) // Legacy staff/customer flag
  sender    MessageSender @default(CUSTOMER)
  botnoiMid String?  @unique // message id จาก Botnoi กันบันทึกซ้ำ

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String

  // ผู้ส่งอาจเป็น User ในระบบหรือไม่ก็ได้
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  projectId    String
  ticketId     String?  @unique
  userId       String?
  customerName String
  rating       Int
  comment      String   @default("")
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket  Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// ===========================
// แชทจาก Botnoi ที่ยังไม่มีใบงานให้ผูก (พักไว้ แล้วย้ายเข้า Message เมื่อสร้างใบงาน)
// ===========================
model BotnoiChatEvent {
  id        String        @id @default(cuid())
  projectId String
  sourceId  String
  channel   String
  sender    MessageSender
  text      String
  customerName String?    // ชื่อโปรไฟล์ LINE ของลูกค้า (แสดงในหน้าแชทก่อนเปิดใบงาน)
  mid       String?       @unique
  sentAt    DateTime
  createdAt DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sentAt])
  @@index([projectId, sourceId, sentAt])
}

// ===========================
// โครงสร้าง event จาก Botnoi (ไม่มีข้อความจริง) ไว้ตรวจรูปแบบ เก็บ 3 วัน
// ===========================
model BotnoiEventLog {
  id        String   @id @default(cuid())
  outcome   String
  shape     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
